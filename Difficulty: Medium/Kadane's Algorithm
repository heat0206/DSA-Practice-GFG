class Solution {
  public:
    int maxSubarraySum(vector<int> &arr) {
        // Code here
        if(arr.size() == 1){
            return arr[0];
        }
        int currSum=0;
        int maxSum =0;
        for(int i=0; i<arr.size(); ++i){
            currSum += arr[i];
            maxSum = max(currSum,maxSum);
            if(currSum < 0){
                currSum = 0;
            }
        }
        
        if(currSum == 0 && maxSum ==0){
            int temp = arr[0];
            for(int i=1; i< arr.size(); i++){
                if(arr[i] > temp){
                    temp = arr[i];
                }
            }
            return temp;
            
        }
        
        return maxSum;
    }
};
